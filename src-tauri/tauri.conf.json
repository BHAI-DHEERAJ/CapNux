{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapNux",
  "version": "0.1.0",
  "identifier": "org.capnux.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CapNux Studio",
        "width": 1480,
        "height": 940,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#0a0c10"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DOWNLOAD/**", "/mnt/**", "/media/**", "/tmp/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Video",
    "shortDescription": "Linux-native video editor",
    "longDescription": "CapNux is a Linux-native non-linear video editor powered by FFmpeg.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "libwebkit2gtk-4.1-0"]
      }
    }
  }
}
